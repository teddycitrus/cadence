{
  "name": "cadence",
  "version": "1.0.1",
  "description": "AI software factory: turns feedback into triaged issues, specs, and reviewed pull requests with human approval gates.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch src/server/main.ts\" \"vite --config config/vite.config.ts\"",
    "build": "tsc -p tsconfig.json && vite build --config config/vite.config.ts",
    "start": "tsx src/server/main.ts",
    "test": "vitest run --config config/vitest.config.ts",
    "lint": "tsc -p tsconfig.json",
    "build:desktop": "node scripts/build-desktop.mjs",
    "app": "npm run build && npm run build:desktop && electron .",
    "package": "npm run build && npm run build:desktop && electron-builder --config config/electron-builder.yml"
  },
  "license": "ISC",
  "type": "module",
  "main": "dist/desktop/main.cjs",
